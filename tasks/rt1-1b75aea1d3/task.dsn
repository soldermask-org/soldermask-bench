    (net "Net-(IC3-PadNR$3)"
      (pins IC3-NR$3)
    )
    (net "Net-(IC3-PadTRIM$5)"
      (pins IC3-TRIM$5)
    )
    (net +15V
      (pins IC3-V_IN$2 SP0-P$1 PP0-P$1 CP1-+ CP2-+ C1-1 C2-1 C3-1 IC1-3 IC2-3)
    )
    (net +5V/1
      (pins IC3-V_OUT$6 RP0-P$1 CP31-+)
    )
    (net -15V
      (pins SP0-P$3 PP0-P$3 CP0-- C0-2)
    )
    (net +5V
      (pins SP1-P$1 R1-1 CP11-+ CP12-+ C11-1 C12-1 IC1-2)
    )
    (net +3V3
      (pins SP1-P$3 R2-1 CP21-+ C21-1 IC2-2 CP22-+ C22-1)
    )
    (net "Net-(IC1-Pad1)"
      (pins R1-2 IC1-1)
    )
    (net "Net-(IC2-Pad1)"
      (pins R2-2 IC2-1)
    )
    (class kicad_default +15V +3V3 +5V +5V/1 -15V GND "Net-(IC1-Pad1)" "Net-(IC2-Pad1)"
      "Net-(IC3-PadNR$3)" "Net-(IC3-PadTRIM$5)"
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 127)
        (clearance 127)
      )
    )
  )
  (wiring
  )
)
