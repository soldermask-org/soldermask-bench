    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net +5V
      (pins .1UF0-1 J1-2 J2-1 "----0"-2 MCU0-8 "---0"-1)
    )
    (net GND
      (pins .1UF0-2 J1-1 J2-2 D1-C "----0"-6 RESET0-3 RESET0-4 MCU0-4)
    )
    (net 0/MOSI
      (pins J3-1 "----0"-4 MCU0-5)
    )
    (net 1/MISO
      (pins J3-2 "----0"-1 MCU0-6)
    )
    (net 2/SCK
      (pins J3-3 "----0"-3 MCU0-7)
    )
    (net 3
      (pins J3-4 MCU0-2)
    )
    (net RST
      (pins J2-3 RESET0-1 RESET0-2 MCU0-1 "---0"-2)
    )
    (net 4
      (pins J2-4 R1-2 MCU0-3)
    )
    (net N$1
      (pins D1-A R1-1)
    )
    (class kicad_default +5V 0/MOSI 1/MISO 2/SCK 3 4 GND N$1 RST
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 127)
        (clearance 127)
      )
    )
  )
  (wiring
  )
)
