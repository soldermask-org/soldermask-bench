    )
    (class kicad_default 5V COL1 COL2 COL3 COL4 GND N$1 N$14 N$15 N$16 N$18
      N$19 N$2 N$20 N$21 N$22 N$23 N$24 N$25 N$3 N$5 NEOPIXEL NEOPIXEL_5V
      ROT1A ROT1B ROT1SW ROT2A ROT2B ROT2SW ROW1 ROW2 ROW3
      (circuit
