    (net /RESET
      (pins C6-1 R1-1 IC1-4 P1-5)
    )
    (net "Net-(IC1-Pad11)"
      (pins R2-1 R5-2 IC1-11 R6-2)
    )
    (net /THERMISTOR
      (pins R2-2 IC1-10 TH1-1)
    )
    (net /EXCITATION
      (pins R4-2 IC1-5)
    )
    (net /MOSI/SDA
      (pins IC1-7 P2-2 P1-4)
    )
    (net /SCK/SCL
      (pins IC1-9 P2-3 P1-3)
    )
    (net "Net-(IC1-Pad12)"
      (pins IC1-12 R9-2)
    )
    (class kicad_default /EXCITATION /MISO/SENSE_HIGH /MOSI/SDA /RESET /SCK/SCL
      /SENSE_LOW /SENSOR_TRACK /THERMISTOR GND "Net-(C1-Pad1)" "Net-(C2-Pad1)"
      "Net-(D3-Pad1)" "Net-(D3-Pad2)" "Net-(IC1-Pad11)" "Net-(IC1-Pad12)"
      VCC
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 127)
        (clearance 127)
      )
    )
  )
  (wiring
  )
)
