      (pins U1-8 R10-1 C1-1 TP1-1 R6-1 R8-1)
    )
    (net /ACATT
      (pins D1-1 R4-1 R3-2 R5-1)
    )
    (net VAC
      (pins J1-1 R3-1)
    )
    (class kicad_default /ACATT /NUSED+ "/NUSED-" /OUT /ZCDIN /ZCDREF GND
      VAC VCC "unconnected-(U1-Pad7)"
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 127)
        (clearance 127)
      )
    )
  )
  (wiring
  )
)
